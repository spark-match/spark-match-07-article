%% Destino sugerido: Seccion 2 (Seleccion de modelo y datos), subseccion
%% Dataset/Preprocesamiento. Hoy esa seccion solo tiene una descripcion en
%% prosa (etapas ingestion.py, data_clean.py, feature_engineering.py); este
%% diagrama la hace visual y deja explicita la etapa "frozen".
%% Nombre de archivo sugerido al renderizar: fig-pipeline-datos.png
%% Caption sugerido: "Pipeline de datos versionado con DVC (4 etapas), con la
%% etapa de ingesta congelada tras el decomiso del portal fuente."
%% Label sugerido: fig:data-pipeline

flowchart LR
    MEC["Ponte en Carrera (MINEDU)<br/>portal oficial"]
    MEC -- "HTTP 500 desde 2026-07-12<br/>(decomisionado)" --> FROZEN[/"etapa ingest: FROZEN"/]

    subgraph DVC["Pipeline DVC (dvc.yaml)"]
        direction LR
        ING["ingest<br/>(ingestion.py, Selenium)"]
        CLEAN["clean<br/>(data_clean.py)<br/>estandariza columnas y tipos,<br/>descarta incompletos"]
        FEAT["features<br/>(feature_engineering.py)<br/>imputacion por etapas +<br/>normalizacion Min-Max [0,1]"]
        RIASEC["riasec<br/>etiquetado LLM (Bedrock)<br/>554 carreras unicas"]
        ING --> CLEAN --> FEAT --> RIASEC
    end

    FROZEN -.->|"se reproduce solo contra<br/>el ultimo raw.xlsx historico"| ING
    ING -.snapshot con fecha y hora.-> SNAP[("snapshots/<br/>fallback local,<br/>sin remoto S3 aun")]
    RIASEC --> CSV[("features.csv<br/>6,208 combinaciones<br/>554 carreras / 25 departamentos")]

    CSV -.->|"NO conectado aun"| AGENTE["Agente conversacional<br/>(catalogo piloto de 19 carreras)"]

    classDef pending fill:#fee2e2,stroke:#c00,stroke-width:1px
    classDef done fill:#dcfce7,stroke:#16a34a,stroke-width:1px
    class MEC,FROZEN pending
    class CSV,RIASEC,FEAT,CLEAN,ING done
