%% Destino sugerido: Seccion 5 (Orquestacion y despliegue). Esta seccion hoy
%% es solo texto (subsecciones de Docker, Terraform, CI/CD, escalabilidad);
%% no tiene ningun diagrama, y es uno de los 12 criterios de la rubrica
%% (Criterio 5, 2 pts) que mas se beneficia de una figura de infraestructura.
%% Nombre de archivo sugerido al renderizar: fig-arquitectura-despliegue.png
%% Caption sugerido: "Arquitectura de despliegue en AWS: pipeline serverless
%% del backend y agente conversacional en ECS Fargate detras de ALB/CloudFront."
%% Label sugerido: fig:deployment-architecture

flowchart TB
    U(("Usuario<br/>(navegador)"))

    subgraph CI["GitHub Actions (spark-match-01-devops)"]
        direction LR
        SC["SonarCloud"]
        CQ["CodeQL"]
        CHK["checkov / tflint"]
        EVM["evals --mode mock<br/>(29 casos, cada PR)"]
    end

    subgraph AWS["AWS (Terraform: dev / prod)"]
        subgraph BE["Backend serverless"]
            EB["EventBridge"]
            LAM["AWS Lambda (TypeScript)<br/>esbuild -> ZIP, Node.js 24.x<br/>solo contexto identity"]
        end

        subgraph AGENTE["Agente conversacional"]
            ECR["Amazon ECR<br/>imagen Docker ARM64"]
            ECS["ECS Fargate<br/>desired_count fijo<br/>(sin autoscaling aun)<br/>deployment circuit breaker"]
            ALB["Application Load Balancer<br/>idle timeout hasta 4000s"]
            CFRONT["CloudFront<br/>terminacion TLS"]
        end

        RDS[("RDS PostgreSQL<br/>compartida: identity + langmem")]
        S3[("S3<br/>snapshots del dataset")]
        BUD["AWS Budgets<br/>control de costos"]
    end

    U -->|HTTPS| CFRONT
    CFRONT --> ALB --> ECS
    ECS -->|TCP 5432<br/>checkpointer LangGraph| RDS
    ECR -->|imagen publicada| ECS
    EB --> LAM
    LAM --> RDS
    U -->|API Gateway HTTP API| LAM

    CI -->|build & push en cada deploy| ECR
    BUD -.vigila gasto mensual.-> AWS

    classDef pending stroke-dasharray: 5 5,stroke:#c00
    class ECS pending
